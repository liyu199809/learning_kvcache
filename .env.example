# 复制为 .env 并填写。加载方：rollout/refine.py、benchmark/eval/run_eval.py
# （python-dotenv，不覆盖 shell 中已 export 的同名变量）。
# .env 已被 gitignore，永远不要提交真实 key。
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# 必填（生成 OPSD 数据集阶段需要教师模型 / LLM 裁判）
# ---------------------------------------------------------------------------
# 火山方舟 API key（OpenAI 兼容端点）。教师模型（refine 阶段的 # Advice）与
# AWM 的 LLM 裁判都走它。
ARK_API_KEY=

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------
# W&B（训练日志上报；也可以用 `wandb login` 代替）
# WANDB_API_KEY=

# ---------------------------------------------------------------------------
# 端点配置（默认值适用于本仓库的默认服务拓扑，一般无需改动）
# ---------------------------------------------------------------------------
# 学生模型（本地 vLLM，start_services.sh 启动）
# ENDPOINT_URL=http://localhost:8000/v1
# AWM_EXAMPLE_AGENT_MODEL=qwen3.5-4b

# 教师模型（OpenAI 兼容端点 + 模型/endpoint id）
# TEACHER_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# TEACHER_MODEL=<ark endpoint id>

# LLM 裁判（缺省复用教师端点与 ARK_API_KEY）
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=

# AWM 环境服务
# AWM_BASE_URL=http://localhost:8899
